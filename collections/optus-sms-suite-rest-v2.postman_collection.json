  "info": {
    "_postman_id": "6fcecb48-64cc-4f4c-8598-7f4759bcc797",
    "name": "SMS Gateway REST APIv2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Optus SMS Suite Mobile Gateway REST APIv2 allows you to send SMS messages to a single handset.\nIt includes automated link shortening.\nHTTPS use is mandatory; all attempts to use plain-text HTTP will be redirected to HTTPS.\nRequest and response data requires JSON encoding. Only HTTP GET and POST methods are required.\nIf you access the API without having the correct credentials OR permission to access the API, you will get a HTTP 401 response.\nYour gateway application credentials ('application name' and password) are available on the platform 'https://sms.optus.com.au/gateway/api_config/restv2'\nYou will need a login and password to retrieve these.\n",
      "type": "text/plain"
    }
  }
